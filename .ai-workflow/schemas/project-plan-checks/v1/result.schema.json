{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-workflow:project-plan-checks:v1:result",
  "title": "Project plan checker result v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "checker_version": {
      "const": "1.0.0"
    },
    "input_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "project_id": {
      "anyOf": [
        {
          "$ref": "urn:ai-workflow:project:v1:common#/$defs/projectId"
        },
        {
          "type": "null"
        }
      ]
    },
    "project_revision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_revision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "project_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "anyOf": [
        {
          "$ref": "urn:ai-workflow:issue:v1:common#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "pass",
        "blocked"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_id": {
            "enum": [
              "input",
              "schema",
              "identity",
              "dag",
              "facts",
              "history",
              "revision",
              "waves",
              "output"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "block",
              "not_evaluated"
            ]
          }
        },
        "required": [
          "check_id",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 9
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z_]*$",
            "maxLength": 64
          },
          "path": {
            "type": "string",
            "maxLength": 256
          },
          "feature_id": {
            "anyOf": [
              {
                "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
              },
              {
                "type": "null"
              }
            ]
          },
          "related": {
            "type": "array",
            "items": {
              "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
            },
            "minItems": 0,
            "maxItems": 1001
          }
        },
        "required": [
          "code",
          "path",
          "feature_id",
          "related"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "waves": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "wave": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "feature_ids": {
            "type": "array",
            "items": {
              "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
            },
            "minItems": 0,
            "maxItems": 1000,
            "uniqueItems": true
          }
        },
        "required": [
          "wave",
          "feature_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "dependency_candidates": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "waiting": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "feature_id": {
            "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z_]*$",
              "maxLength": 64
            },
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true
          },
          "related": {
            "type": "array",
            "items": {
              "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
            },
            "minItems": 0,
            "maxItems": 1000,
            "uniqueItems": true
          }
        },
        "required": [
          "feature_id",
          "reasons",
          "related"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "active": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "completed": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "cancelled": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "serialization": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "feature_id": {
            "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
          },
          "after_feature_ids": {
            "type": "array",
            "items": {
              "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
            },
            "minItems": 0,
            "maxItems": 1000,
            "uniqueItems": true
          },
          "area_ids": {
            "type": "array",
            "items": {
              "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
            },
            "minItems": 0,
            "maxItems": 200,
            "uniqueItems": true
          },
          "reason": {
            "const": "area_serialized"
          }
        },
        "required": [
          "feature_id",
          "after_feature_ids",
          "area_ids",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "revision_impact": {
      "type": "object",
      "properties": {
        "changed_feature_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
          },
          "minItems": 0,
          "maxItems": 2000,
          "uniqueItems": true
        },
        "affected_feature_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
          },
          "minItems": 0,
          "maxItems": 2000,
          "uniqueItems": true
        },
        "invalidated_waves": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "active_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "feature_id": {
                "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
              },
              "decision": {
                "enum": [
                  "continue",
                  "pause",
                  "cancel"
                ]
              }
            },
            "required": [
              "feature_id",
              "decision"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 2000
        }
      },
      "required": [
        "changed_feature_ids",
        "affected_feature_ids",
        "invalidated_waves",
        "active_decisions"
      ],
      "additionalProperties": false
    },
    "not_evaluated": {
      "type": "array",
      "items": {
        "enum": [
          "membership_permission_capacity",
          "reference_existence",
          "approval_authenticity",
          "snapshot_freshness",
          "feature_completion_aggregation",
          "full_history_provenance",
          "disjoint_scope_proof",
          "empty_plan"
        ]
      },
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "checker_version",
    "input_digest",
    "project_id",
    "project_revision",
    "plan_revision",
    "project_digest",
    "plan_digest",
    "observed_at",
    "status",
    "checks",
    "diagnostics",
    "waves",
    "dependency_candidates",
    "waiting",
    "active",
    "completed",
    "cancelled",
    "serialization",
    "revision_impact",
    "not_evaluated"
  ],
  "additionalProperties": false
}
