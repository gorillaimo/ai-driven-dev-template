{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-workflow:project-plan-checks:v1:context",
  "title": "Project plan checker context v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "$ref": "urn:ai-workflow:project:v1:common#/$defs/projectId"
    },
    "project_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "project_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observed_at": {
      "$ref": "urn:ai-workflow:issue:v1:common#/$defs/timestamp"
    },
    "recorded_by": {
      "$ref": "urn:ai-workflow:issue:v1:common#/$defs/actor"
    },
    "source": {
      "$ref": "urn:ai-workflow:issue:v1:common#/$defs/reference"
    },
    "feature_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "feature_id": {
            "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
          },
          "state": {
            "enum": [
              "planned",
              "active",
              "completed",
              "blocked",
              "cancelled",
              "unknown"
            ]
          },
          "evidence": {
            "$ref": "urn:ai-workflow:issue:v1:common#/$defs/reference"
          }
        },
        "required": [
          "feature_id",
          "state"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "active",
                    "completed",
                    "blocked",
                    "cancelled"
                  ]
                }
              },
              "required": [
                "state"
              ]
            },
            "then": {
              "properties": {
                "evidence": {
                  "$ref": "urn:ai-workflow:issue:v1:common#/$defs/reference"
                }
              },
              "required": [
                "evidence"
              ]
            }
          }
        ]
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "constraint_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "feature_id": {
            "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
          },
          "constraint_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999
          },
          "state": {
            "enum": [
              "satisfied",
              "pending",
              "unknown"
            ]
          },
          "evidence": {
            "$ref": "urn:ai-workflow:issue:v1:common#/$defs/reference"
          }
        },
        "required": [
          "feature_id",
          "constraint_index",
          "state"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "satisfied"
                  ]
                }
              },
              "required": [
                "state"
              ]
            },
            "then": {
              "properties": {
                "evidence": {
                  "$ref": "urn:ai-workflow:issue:v1:common#/$defs/reference"
                }
              },
              "required": [
                "evidence"
              ]
            }
          }
        ]
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "replan_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "feature_id": {
            "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
          },
          "decision": {
            "enum": [
              "continue",
              "pause",
              "cancel"
            ]
          },
          "approval": {
            "$ref": "urn:ai-workflow:issue:v1:common#/$defs/approval"
          }
        },
        "required": [
          "feature_id",
          "decision",
          "approval"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "project_revision",
    "plan_revision",
    "project_digest",
    "plan_digest",
    "observed_at",
    "recorded_by",
    "source",
    "feature_facts",
    "constraint_facts",
    "replan_decisions"
  ],
  "additionalProperties": false
}
