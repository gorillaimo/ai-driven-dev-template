{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-workflow:runner:v1:capability",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_kind": {
      "const": "runner-capability"
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "adapter_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "image": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "mode": {
      "enum": ["synthetic", "production"]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "checks": {
      "type": "object",
      "properties": {
        "version": {
          "type": "boolean"
        },
        "noninteractive": {
          "type": "boolean"
        },
        "structured_output": {
          "type": "boolean"
        },
        "isolated_write": {
          "type": "boolean"
        },
        "network_none": {
          "type": "boolean"
        },
        "credential_separation": {
          "type": "boolean"
        },
        "resource_limits": {
          "type": "boolean"
        },
        "stop_tree": {
          "type": "boolean"
        },
        "resume": {
          "type": "boolean"
        },
        "usage": {
          "type": "boolean"
        },
        "model_gateway": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "noninteractive",
        "structured_output",
        "isolated_write",
        "network_none",
        "credential_separation",
        "resource_limits",
        "stop_tree",
        "resume",
        "usage",
        "model_gateway"
      ],
      "additionalProperties": false
    },
    "evidence_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "artifact_kind",
    "adapter_id",
    "adapter_digest",
    "image",
    "mode",
    "observed_at",
    "checks",
    "evidence_digest"
  ],
  "additionalProperties": false
}
