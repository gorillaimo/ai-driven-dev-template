{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-workflow:runner:v1:profile",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_kind": {
      "const": "runner-profile"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "repository_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "human_owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "owner_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "execution_profile_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "adapter_id": {
      "const": "codex-0-166-0"
    },
    "adapter_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "image": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "read_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
      },
      "maxItems": 1000,
      "uniqueItems": true
    },
    "write_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
      },
      "maxItems": 1000,
      "uniqueItems": true
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
      },
      "maxItems": 1000,
      "uniqueItems": true
    },
    "send_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
      },
      "maxItems": 1000,
      "uniqueItems": true
    },
    "model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "endpoint": {
          "const": "https://api.openai.com/v1/responses"
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "input_microusd_per_million": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000000
        },
        "output_microusd_per_million": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000000
        },
        "pricing_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "pricing_expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "endpoint",
        "context_tokens",
        "input_microusd_per_million",
        "output_microusd_per_million",
        "pricing_digest",
        "pricing_expires_at"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_ai_workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "run_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 21600
        },
        "call_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        },
        "cleanup_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "max_repairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "memory_mib": {
          "type": "integer",
          "minimum": 64,
          "maximum": 2048
        },
        "cpus": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "pids": {
          "type": "integer",
          "minimum": 16,
          "maximum": 128
        },
        "scratch_mib": {
          "type": "integer",
          "minimum": 16,
          "maximum": 256
        },
        "max_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_input_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128000
        },
        "cost_microusd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        }
      },
      "required": [
        "max_ai_workers",
        "run_seconds",
        "call_seconds",
        "cleanup_seconds",
        "max_repairs",
        "memory_mib",
        "cpus",
        "pids",
        "scratch_mib",
        "max_requests",
        "max_input_tokens",
        "max_output_tokens",
        "cost_microusd"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "artifact_kind",
    "id",
    "revision",
    "repository",
    "repository_id",
    "human_owner",
    "owner_id",
    "execution_profile_digest",
    "policy_digest",
    "adapter_id",
    "adapter_digest",
    "image",
    "read_paths",
    "write_paths",
    "forbidden_paths",
    "send_paths",
    "model",
    "limits"
  ],
  "additionalProperties": false
}
