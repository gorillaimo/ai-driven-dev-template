{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-workflow:runner:v1:result",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_kind": {
      "const": "runner-result"
    },
    "status": {
      "enum": ["passed", "blocked", "failed", "stopped", "unknown"]
    },
    "mode": {
      "enum": ["synthetic", "production"]
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "profile_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:runner:v1:attempt"
      },
      "maxItems": 10000,
      "uniqueItems": true
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z0-9_]+$"
      },
      "maxItems": 1000,
      "uniqueItems": true
    },
    "not_evaluated": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z0-9_]+$"
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:execution:v1:common#/$defs/reference"
      },
      "maxItems": 1000,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "mode",
    "run_id",
    "profile_digest",
    "attempts",
    "diagnostics",
    "not_evaluated",
    "evidence_refs"
  ],
  "additionalProperties": false
}
