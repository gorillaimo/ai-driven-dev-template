{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-workflow:github:v1:policy",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_kind": {
      "const": "github-policy"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "repository_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "owner": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "login": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "id",
        "login"
      ],
      "additionalProperties": false
    },
    "profile": {
      "$ref": "urn:ai-workflow:execution:v1:common#/$defs/reference"
    },
    "mode": {
      "enum": [
        "trial",
        "production"
      ]
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "base_branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "branch_prefix": {
      "const": "ai-work/"
    },
    "protected_branches": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
      },
      "maxItems": 100,
      "minItems": 1
    },
    "allowed_operations": {
      "type": "array",
      "items": {
        "enum": [
          "create_branch",
          "publish_commit",
          "append_claim",
          "append_record",
          "create_draft_pr",
          "update_draft_pr"
        ]
      },
      "maxItems": 6,
      "minItems": 1
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
      },
      "maxItems": 1000,
      "minItems": 1
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
      },
      "maxItems": 1000,
      "minItems": 0
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "request_ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "monitor_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "limits": {
      "type": "object",
      "properties": {
        "collector_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400
        },
        "page_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "resource_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "discussion_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "response_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        },
        "raw_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "operation_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "operation_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "file_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "change_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5242880
        },
        "journal_transitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "journal_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        }
      },
      "required": [
        "collector_seconds",
        "requests",
        "page_items",
        "resource_items",
        "discussion_items",
        "response_bytes",
        "raw_bytes",
        "operation_seconds",
        "operation_requests",
        "file_count",
        "file_bytes",
        "change_bytes",
        "journal_transitions",
        "journal_bytes"
      ],
      "additionalProperties": false
    },
    "manual_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "body_digest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "disposition": {
            "enum": [
              "not_claim",
              "active_claim",
              "released_claim"
            ]
          }
        },
        "required": [
          "id",
          "body_digest",
          "disposition"
        ],
        "additionalProperties": false
      },
      "maxItems": 10000,
      "minItems": 0
    },
    "delegates": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "login": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "id",
          "login"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "artifact_kind",
    "artifact_id",
    "revision",
    "repository",
    "repository_id",
    "owner",
    "profile",
    "mode",
    "reviewed_at",
    "expires_at",
    "base_branch",
    "branch_prefix",
    "protected_branches",
    "allowed_operations",
    "allowed_paths",
    "forbidden_paths",
    "ttl_seconds",
    "request_ttl_seconds",
    "monitor_seconds",
    "limits",
    "manual_mappings"
  ],
  "additionalProperties": false
}
