{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-workflow:github:v1:receipt",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_kind": {
      "const": "github-receipt"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "operation_kind": {
      "enum": [
        "create_branch",
        "publish_commit",
        "append_claim",
        "append_record",
        "create_draft_pr",
        "update_draft_pr"
      ]
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "repository_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "issue_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "worker_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "expected_head": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-f0-9]{40}$"
    },
    "policy_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "grant_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "prepared",
        "sending",
        "confirmed",
        "unknown",
        "failed"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "step": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "request_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "confirmed_steps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "expected": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "branch",
            "ref",
            "comment",
            "pr",
            "git-object"
          ]
        },
        "terminal": {
          "type": "boolean"
        },
        "sha": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-f0-9]{40}$"
        },
        "body_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "marker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
        },
        "head": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "base": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "object_type": {
          "enum": [
            "blobs",
            "trees",
            "commits"
          ]
        }
      },
      "required": [
        "kind",
        "terminal"
      ],
      "additionalProperties": false
    },
    "observed": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-f0-9]{40}$"
        },
        "body_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:github:v1:common#/$defs/diagnostic"
      },
      "maxItems": 1000,
      "minItems": 0
    },
    "partial": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "artifact_kind",
    "operation_id",
    "operation_kind",
    "repository",
    "repository_id",
    "issue_number",
    "run_id",
    "claim_id",
    "worker_id",
    "generation",
    "branch",
    "expected_head",
    "policy_digest",
    "grant_digest",
    "input_digest",
    "status",
    "recorded_at",
    "step",
    "request_count",
    "confirmed_steps",
    "expected",
    "observed",
    "diagnostics",
    "partial"
  ],
  "additionalProperties": false
}
