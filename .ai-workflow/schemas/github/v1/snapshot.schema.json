{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-workflow:github:v1:snapshot",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_kind": {
      "const": "github-snapshot"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "repository_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "unavailable"
      ]
    },
    "policy_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "default_branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "sections": {
      "type": "object",
      "properties": {
        "issues": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "prs": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "branches": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "comments": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "reviews": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "permissions": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "protections": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        }
      },
      "required": [
        "issues",
        "prs",
        "branches",
        "comments",
        "reviews",
        "permissions",
        "protections"
      ],
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "state": {
            "enum": [
              "open",
              "closed"
            ]
          },
          "assignees": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "login": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [
                "id",
                "login"
              ],
              "additionalProperties": false
            },
            "maxItems": 100,
            "minItems": 0
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxItems": 100,
            "minItems": 0
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "body_digest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "contract_digest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "number",
          "state",
          "assignees",
          "labels",
          "updated_at",
          "body_digest",
          "contract_digest"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000,
      "minItems": 0
    },
    "prs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "state": {
            "enum": [
              "open",
              "closed"
            ]
          },
          "draft": {
            "type": "boolean"
          },
          "head_branch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "head_sha": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[a-f0-9]{40}$"
          },
          "base_branch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "base_sha": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[a-f0-9]{40}$"
          },
          "head_repository_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "merged": {
            "type": "boolean"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "body_digest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "actor_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "number",
          "state",
          "draft",
          "head_branch",
          "head_sha",
          "base_branch",
          "base_sha",
          "head_repository_id",
          "merged",
          "updated_at",
          "body_digest",
          "actor_id"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000,
      "minItems": 0
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "sha": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[a-f0-9]{40}$"
          },
          "protected": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "sha",
          "protected"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000,
      "minItems": 0
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:github:v1:common#/$defs/source"
      },
      "maxItems": 10000,
      "minItems": 0
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actor_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "login": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "permission": {
            "enum": [
              "read",
              "triage",
              "write",
              "maintain",
              "admin",
              "none"
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "actor_id",
          "login",
          "permission",
          "observed_at"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000,
      "minItems": 0
    },
    "protections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "branch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "enforced": {
            "enum": [
              true,
              false,
              "unknown"
            ]
          },
          "bypass_actors": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "maxItems": 1000,
                "minItems": 0
              }
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_digest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "branch",
          "enforced",
          "bypass_actors",
          "observed_at",
          "source_digest"
        ],
        "additionalProperties": false
      },
      "maxItems": 100,
      "minItems": 0
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "etag": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "row_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "revalidated": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "etag",
          "observed_at",
          "row_count",
          "revalidated"
        ],
        "additionalProperties": false
      },
      "maxItems": 400,
      "minItems": 0
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[a-z0-9_]+$"
      },
      "maxItems": 1000,
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "artifact_kind",
    "repository",
    "repository_id",
    "started_at",
    "finished_at",
    "status",
    "policy_digest",
    "default_branch",
    "sections",
    "issues",
    "prs",
    "branches",
    "sources",
    "permissions",
    "protections",
    "pages",
    "unresolved"
  ],
  "additionalProperties": false
}
