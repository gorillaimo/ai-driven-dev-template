{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-workflow:github:v1:common",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-f0-9]{40}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "comment",
            "review"
          ]
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issue_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "actor_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "actor_type": {
          "enum": [
            "User",
            "Bot"
          ]
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "body_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "state": {
          "enum": [
            "active",
            "dismissed",
            "pending"
          ]
        },
        "machine": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "urn:ai-workflow:github:v1:common#/$defs/machine"
            }
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "issue_number",
        "actor_id",
        "actor_type",
        "updated_at",
        "body_digest",
        "state",
        "machine"
      ],
      "additionalProperties": false
    },
    "machine": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "create_branch",
            "publish_commit",
            "append_claim",
            "append_record",
            "create_draft_pr",
            "update_draft_pr"
          ]
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
        },
        "claim_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
        },
        "worker_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issue_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "input_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "confirmed",
            "unknown",
            "failed",
            "released"
          ]
        },
        "record_kind": {
          "enum": [
            "claim",
            "progress",
            "report"
          ]
        },
        "record_status": {
          "enum": [
            "in_progress",
            "blocked",
            "completed"
          ]
        }
      },
      "required": [
        "version",
        "operation_id",
        "kind",
        "run_id",
        "claim_id",
        "worker_id",
        "generation",
        "repository_id",
        "issue_number",
        "input_digest",
        "status",
        "record_kind",
        "record_status"
      ],
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "artifact_kind": {
          "const": "approval-proof"
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
        },
        "payload": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "policy",
                "design"
              ]
            },
            "reference": {
              "$ref": "urn:ai-workflow:execution:v1:common#/$defs/reference"
            },
            "source": {
              "$ref": "urn:ai-workflow:github:v1:common#/$defs/source"
            },
            "target_digest": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "actor_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "repository_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "issued_at": {
              "type": "string",
              "format": "date-time"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "kind",
            "reference",
            "source",
            "target_digest",
            "actor_id",
            "repository_id",
            "issued_at",
            "expires_at"
          ],
          "additionalProperties": false
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      },
      "required": [
        "schema_version",
        "artifact_kind",
        "issuer",
        "key_id",
        "payload",
        "signature"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9_]+$"
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    }
  }
}
