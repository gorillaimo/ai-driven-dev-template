{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-workflow:github:v2:operation",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_kind": {
      "const": "github-operation"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "kind": {
      "const": "append_record"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "repository_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "issue_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "worker_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "expected_head": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-f0-9]{40}$"
    },
    "policy_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "grant_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "stage": {
      "$ref": "urn:ai-workflow:issue:v1:common#/$defs/stage"
    },
    "payload": {
      "type": "object",
      "properties": {
        "record_kind": {
          "const": "integration-report"
        },
        "result_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "summary_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "record_kind",
        "result_digest",
        "summary_digest"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "artifact_kind",
    "operation_id",
    "kind",
    "repository",
    "repository_id",
    "issue_number",
    "run_id",
    "claim_id",
    "worker_id",
    "generation",
    "branch",
    "expected_head",
    "policy_digest",
    "grant_digest",
    "stage",
    "payload"
  ],
  "additionalProperties": false,
  "title": "github/v2 integration summary operation"
}
