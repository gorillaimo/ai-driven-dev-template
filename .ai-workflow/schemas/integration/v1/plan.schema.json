{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-workflow:integration:v1:plan",
  "title": "integration/v1 plan",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_kind": {
      "const": "integration-plan"
    },
    "authority": {
      "const": false
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "repository_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "request_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "main_sha": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "bundle_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:execution:v1:common#/$defs/target"
      },
      "minItems": 1,
      "maxItems": 10
    },
    "order": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "minItems": 1,
      "maxItems": 10
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
          },
          "issue_numbers": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "minItems": 1,
            "maxItems": 10
          }
        },
        "required": [
          "case_id",
          "issue_numbers"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 11
    },
    "profile": {
      "$ref": "urn:ai-workflow:execution:v1:common#/$defs/reference"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "image": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "checks_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "not_evaluated": {
      "type": "array",
      "items": {
        "enum": [
          "all_subsets_and_orders",
          "human_merge_approval"
        ]
      },
      "minItems": 1,
      "maxItems": 10
    }
  },
  "required": [
    "schema_version",
    "artifact_kind",
    "authority",
    "run_id",
    "repository",
    "repository_id",
    "request_digest",
    "profile_digest",
    "plan_digest",
    "main_sha",
    "bundle_digest",
    "targets",
    "order",
    "cases",
    "profile",
    "scope",
    "image",
    "checks_digest",
    "not_evaluated"
  ],
  "additionalProperties": false
}
