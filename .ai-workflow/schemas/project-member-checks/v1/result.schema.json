{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-workflow:project-member-checks:v1:result",
  "title": "Project member checker result v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "checker_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "input_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "project_id": {
      "anyOf": [
        {
          "$ref": "urn:ai-workflow:project:v1:common#/$defs/projectId"
        },
        {
          "type": "null"
        }
      ]
    },
    "project_revision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "team_revision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "project_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "team_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "anyOf": [
        {
          "$ref": "urn:ai-workflow:issue:v1:common#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluated_at": {
      "anyOf": [
        {
          "$ref": "urn:ai-workflow:issue:v1:common#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "pass",
        "blocked"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_id": {
            "enum": [
              "input",
              "schema",
              "identity",
              "configuration",
              "facts",
              "principal",
              "subject",
              "ownership",
              "capacity",
              "output"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "block"
            ]
          }
        },
        "required": [
          "check_id",
          "status"
        ],
        "additionalProperties": false
      },
      "maxItems": 10,
      "minItems": 0
    },
    "subject": {
      "type": "object",
      "properties": {
        "github_login": {
          "anyOf": [
            {
              "$ref": "urn:ai-workflow:issue:v1:common#/$defs/login"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "candidate",
                "assigned_owner"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "qualification": {
          "enum": [
            "eligible",
            "ineligible",
            "unknown"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z_]*$",
            "maxLength": 64
          },
          "maxItems": 1000,
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "github_login",
        "mode",
        "qualification",
        "reasons"
      ],
      "additionalProperties": false
    },
    "coordinators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "github_login": {
            "$ref": "urn:ai-workflow:issue:v1:common#/$defs/login"
          },
          "area_ids": {
            "type": "array",
            "items": {
              "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
            },
            "maxItems": 200,
            "minItems": 0,
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "pass",
              "blocked",
              "unknown"
            ]
          }
        },
        "required": [
          "github_login",
          "area_ids",
          "status"
        ],
        "additionalProperties": false
      },
      "maxItems": 200,
      "minItems": 0
    },
    "integration_owners": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "area_id": {
            "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
          },
          "github_login": {
            "$ref": "urn:ai-workflow:issue:v1:common#/$defs/login"
          },
          "source": {
            "enum": [
              "default",
              "override"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "blocked",
              "unknown"
            ]
          }
        },
        "required": [
          "area_id",
          "github_login",
          "source",
          "status"
        ],
        "additionalProperties": false
      },
      "maxItems": 200,
      "minItems": 0
    },
    "capacity": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "active_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "additional_count": {
              "enum": [
                0,
                1
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "active_count",
            "additional_count",
            "limit"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z_]*$",
            "maxLength": 64
          },
          "kind": {
            "enum": [
              "invalid",
              "ineligible",
              "unknown"
            ]
          },
          "path": {
            "type": "string",
            "maxLength": 256
          },
          "github_login": {
            "anyOf": [
              {
                "$ref": "urn:ai-workflow:issue:v1:common#/$defs/login"
              },
              {
                "type": "null"
              }
            ]
          },
          "area_id": {
            "anyOf": [
              {
                "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "kind",
          "path",
          "github_login",
          "area_id"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000,
      "minItems": 0
    },
    "not_evaluated": {
      "type": "array",
      "items": {
        "enum": [
          "live_github_and_evidence_authenticity",
          "actual_time_and_inventory_completeness",
          "issue_contract_and_ready_for_ai",
          "workflow_approvals",
          "plan_dependencies",
          "actual_scope_conflicts",
          "atomic_claim",
          "actual_work_execution"
        ]
      },
      "maxItems": 8,
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "checker_version",
    "input_digest",
    "project_id",
    "project_revision",
    "team_revision",
    "project_digest",
    "team_digest",
    "observed_at",
    "evaluated_at",
    "status",
    "checks",
    "subject",
    "coordinators",
    "integration_owners",
    "capacity",
    "diagnostics",
    "not_evaluated"
  ],
  "additionalProperties": false
}
