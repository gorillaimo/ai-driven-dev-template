{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-workflow:execution:v1:result",
  "title": "execution/v1 result",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_kind": {
      "const": "result"
    },
    "checker_version": {
      "const": "1.0.0"
    },
    "input_digest": {
      "anyOf": [
        {
          "$ref": "urn:ai-workflow:execution:v1:common#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluated_at": {
      "anyOf": [
        {
          "$ref": "urn:ai-workflow:issue:v1:common#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "pass",
        "blocked"
      ]
    },
    "decision": {
      "enum": [
        "evidence_complete",
        "needs_work",
        "human_review",
        "invalid"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_kind": {
            "enum": [
              "verification",
              "review",
              "security-result",
              "integration-result",
              "condition"
            ]
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "status": {
            "$ref": "urn:ai-workflow:execution:v1:common#/$defs/outcome"
          }
        },
        "required": [
          "check_kind",
          "index",
          "status"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000,
      "minItems": 0
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              "artifact_kind_invalid",
              "input_invalid",
              "input_limit",
              "schema_invalid",
              "binding_mismatch",
              "reference_missing",
              "reference_mismatch",
              "duplicate_record",
              "history_changed",
              "history_missing",
              "authorization_invalid",
              "condition_unknown",
              "evidence_missing",
              "evidence_failed",
              "evidence_error",
              "evidence_not_evaluated",
              "evidence_stale",
              "time_invalid",
              "execution_invalid",
              "scope_invalid",
              "review_invalid",
              "finding_open",
              "finding_disputed",
              "resolution_invalid",
              "exception_invalid",
              "human_exception",
              "integration_invalid",
              "report_invalid",
              "event_invalid",
              "diagnostic_limit",
              "output_limit",
              "policy_invalid"
            ]
          },
          "artifact_kind": {
            "enum": [
              "profile",
              "grant",
              "verification",
              "review",
              "security-result",
              "integration-result",
              "run-report",
              "event",
              "context",
              "result",
              "input"
            ]
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "code",
          "artifact_kind",
          "index"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000,
      "minItems": 0
    },
    "not_evaluated": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
      },
      "maxItems": 100,
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "artifact_kind",
    "checker_version",
    "input_digest",
    "evaluated_at",
    "status",
    "decision",
    "checks",
    "diagnostics",
    "not_evaluated"
  ],
  "additionalProperties": false
}
