{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-workflow:execution:v1:security-result",
  "title": "execution/v1 security-result",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_kind": {
      "const": "security-result"
    },
    "artifact_id": {
      "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
    },
    "revision": {
      "$ref": "urn:ai-workflow:issue:v1:common#/$defs/revision"
    },
    "repository": {
      "$ref": "urn:ai-workflow:execution:v1:common#/$defs/repository"
    },
    "recorded_at": {
      "$ref": "urn:ai-workflow:issue:v1:common#/$defs/timestamp"
    },
    "recorded_by": {
      "$ref": "urn:ai-workflow:issue:v1:common#/$defs/actor"
    },
    "input_digest": {
      "$ref": "urn:ai-workflow:execution:v1:common#/$defs/digest"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:execution:v1:common#/$defs/reference"
      },
      "maxItems": 1000,
      "minItems": 1
    },
    "subject": {
      "$ref": "urn:ai-workflow:execution:v1:common#/$defs/subject"
    },
    "check_id": {
      "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
    },
    "scanner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "scanner_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "rules_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "database_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "database_fetched_at": {
      "$ref": "urn:ai-workflow:issue:v1:common#/$defs/timestamp"
    },
    "formats": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "maxItems": 100,
      "minItems": 1
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:issue:v1:common#/$defs/filePath"
      },
      "maxItems": 1000,
      "minItems": 0
    },
    "supported": {
      "type": "boolean"
    },
    "started_at": {
      "$ref": "urn:ai-workflow:issue:v1:common#/$defs/timestamp"
    },
    "finished_at": {
      "$ref": "urn:ai-workflow:issue:v1:common#/$defs/timestamp"
    },
    "status": {
      "$ref": "urn:ai-workflow:execution:v1:common#/$defs/outcome"
    },
    "log_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:execution:v1:common#/$defs/reference"
      },
      "maxItems": 1000,
      "minItems": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:execution:v1:common#/$defs/finding"
      },
      "maxItems": 1000,
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "artifact_kind",
    "artifact_id",
    "revision",
    "repository",
    "recorded_at",
    "recorded_by",
    "input_digest",
    "evidence_refs",
    "subject",
    "check_id",
    "scanner",
    "scanner_version",
    "rules_version",
    "database_version",
    "database_fetched_at",
    "formats",
    "exclusions",
    "supported",
    "started_at",
    "finished_at",
    "status",
    "log_refs",
    "findings"
  ],
  "additionalProperties": false
}
