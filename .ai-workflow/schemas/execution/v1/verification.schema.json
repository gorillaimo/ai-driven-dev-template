{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-workflow:execution:v1:verification",
  "title": "execution/v1 verification",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_kind": {
      "const": "verification"
    },
    "artifact_id": {
      "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
    },
    "revision": {
      "$ref": "urn:ai-workflow:issue:v1:common#/$defs/revision"
    },
    "repository": {
      "$ref": "urn:ai-workflow:execution:v1:common#/$defs/repository"
    },
    "recorded_at": {
      "$ref": "urn:ai-workflow:issue:v1:common#/$defs/timestamp"
    },
    "recorded_by": {
      "$ref": "urn:ai-workflow:issue:v1:common#/$defs/actor"
    },
    "input_digest": {
      "$ref": "urn:ai-workflow:execution:v1:common#/$defs/digest"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:execution:v1:common#/$defs/reference"
      },
      "maxItems": 1000,
      "minItems": 1
    },
    "subject": {
      "$ref": "urn:ai-workflow:execution:v1:common#/$defs/subject"
    },
    "check_id": {
      "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
    },
    "domain": {
      "enum": [
        "app",
        "template"
      ]
    },
    "acs": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
      },
      "maxItems": 1000,
      "minItems": 1
    },
    "command_id": {
      "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
    },
    "argv_redacted": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2048
      },
      "maxItems": 256,
      "minItems": 0
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "tool_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "started_at": {
      "$ref": "urn:ai-workflow:issue:v1:common#/$defs/timestamp"
    },
    "finished_at": {
      "$ref": "urn:ai-workflow:issue:v1:common#/$defs/timestamp"
    },
    "status": {
      "$ref": "urn:ai-workflow:execution:v1:common#/$defs/outcome"
    },
    "log_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:execution:v1:common#/$defs/reference"
      },
      "maxItems": 1000,
      "minItems": 1
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        {
          "type": "null"
        }
      ]
    },
    "test_count": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:issue:v1:common#/$defs/filePath"
      },
      "maxItems": 1000,
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "artifact_kind",
    "artifact_id",
    "revision",
    "repository",
    "recorded_at",
    "recorded_by",
    "input_digest",
    "evidence_refs",
    "subject",
    "check_id",
    "domain",
    "acs",
    "command_id",
    "argv_redacted",
    "environment",
    "tool_version",
    "started_at",
    "finished_at",
    "status",
    "log_refs",
    "exit_code",
    "test_count",
    "scope"
  ],
  "additionalProperties": false
}
