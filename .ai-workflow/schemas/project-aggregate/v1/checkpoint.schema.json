{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-workflow:project-aggregate:v1:checkpoint",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "$ref": "urn:ai-workflow:project:v1:common#/$defs/projectId"
    },
    "repository": {
      "$ref": "urn:ai-workflow:project:v1:common#/$defs/repositoryCoordinate"
    },
    "project_revision": {
      "$ref": "urn:ai-workflow:issue:v1:common#/$defs/revision"
    },
    "plan_revision": {
      "$ref": "urn:ai-workflow:issue:v1:common#/$defs/revision"
    },
    "project_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observed_at": {
      "$ref": "urn:ai-workflow:issue:v1:common#/$defs/timestamp"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_ref": {
            "$ref": "urn:ai-workflow:issue:v1:common#/$defs/issueRef"
          },
          "work_id": {
            "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "event_id": {
                  "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "event_id",
                "digest"
              ],
              "additionalProperties": false
            },
            "maxItems": 10000
          }
        },
        "required": [
          "issue_ref",
          "work_id",
          "events"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "repository",
    "project_revision",
    "plan_revision",
    "project_digest",
    "plan_digest",
    "source_input_digest",
    "observed_at",
    "issues"
  ],
  "additionalProperties": false
}
