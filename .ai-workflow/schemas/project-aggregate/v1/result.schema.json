{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-workflow:project-aggregate:v1:result",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "aggregator_version": {
      "const": "1.0.0"
    },
    "input_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "project_id": {
      "anyOf": [
        {
          "$ref": "urn:ai-workflow:project:v1:common#/$defs/projectId"
        },
        {
          "type": "null"
        }
      ]
    },
    "project_revision": {
      "anyOf": [
        {
          "$ref": "urn:ai-workflow:issue:v1:common#/$defs/revision"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_revision": {
      "anyOf": [
        {
          "$ref": "urn:ai-workflow:issue:v1:common#/$defs/revision"
        },
        {
          "type": "null"
        }
      ]
    },
    "project_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "anyOf": [
        {
          "$ref": "urn:ai-workflow:issue:v1:common#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluated_at": {
      "anyOf": [
        {
          "$ref": "urn:ai-workflow:issue:v1:common#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "pass",
        "blocked"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "enum": [
              "pass",
              "block"
            ]
          }
        },
        "required": [
          "check_id",
          "status"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_ref": {
            "$ref": "urn:ai-workflow:issue:v1:common#/$defs/issueRef"
          },
          "work_id": {
            "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
          },
          "feature_id": {
            "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
          },
          "observed_project_status": {
            "anyOf": [
              {
                "enum": [
                  "draft",
                  "available_for_work",
                  "assigned",
                  "in_progress",
                  "in_review",
                  "blocked",
                  "completed",
                  "cancelled"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "reconciliation_status": {
            "enum": [
              "consistent",
              "blocked",
              "unknown"
            ]
          },
          "human_owner": {
            "anyOf": [
              {
                "$ref": "urn:ai-workflow:issue:v1:common#/$defs/login"
              },
              {
                "type": "null"
              }
            ]
          },
          "active_claim_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "prepared_claim_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "workflow": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "current_stage": {
                    "anyOf": [
                      {
                        "$ref": "urn:ai-workflow:issue:v1:common#/$defs/stage"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "resume_decision": {
                    "enum": [
                      "candidate",
                      "blocked",
                      "terminal"
                    ]
                  },
                  "append_only": {
                    "enum": [
                      "pass",
                      "block",
                      "not_evaluated"
                    ]
                  },
                  "checks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "check_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "status": {
                          "enum": [
                            "pass",
                            "block",
                            "not_evaluated"
                          ]
                        }
                      },
                      "required": [
                        "check_id",
                        "status"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 100
                  }
                },
                "required": [
                  "status",
                  "current_stage",
                  "resume_decision",
                  "append_only",
                  "checks"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "new_event_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "branch_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
            },
            "maxItems": 100
          },
          "pr_numbers": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maxItems": 100
          }
        },
        "required": [
          "issue_ref",
          "work_id",
          "feature_id",
          "observed_project_status",
          "reconciliation_status",
          "human_owner",
          "active_claim_count",
          "prepared_claim_count",
          "workflow",
          "new_event_count",
          "branch_refs",
          "pr_numbers"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "feature_id": {
            "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
          },
          "status": {
            "enum": [
              "planned",
              "ready",
              "active",
              "blocked",
              "completed",
              "cancelled",
              "unknown"
            ]
          },
          "required_issue_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "completed_required_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "feature_id",
          "status",
          "required_issue_count",
          "completed_required_count"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "counts": {
      "type": "object",
      "properties": {
        "issue_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "feature_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "issue_statuses": {
          "type": "object",
          "properties": {
            "draft": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "available_for_work": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "assigned": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "in_progress": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "in_review": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "blocked": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "completed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cancelled": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unknown": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "draft",
            "available_for_work",
            "assigned",
            "in_progress",
            "in_review",
            "blocked",
            "completed",
            "cancelled",
            "unknown"
          ],
          "additionalProperties": false
        },
        "feature_statuses": {
          "type": "object",
          "properties": {
            "planned": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "ready": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "active": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "blocked": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "completed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cancelled": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unknown": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "planned",
            "ready",
            "active",
            "blocked",
            "completed",
            "cancelled",
            "unknown"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "issue_count",
        "feature_count",
        "issue_statuses",
        "feature_statuses"
      ],
      "additionalProperties": false
    },
    "checkpoint": {
      "anyOf": [
        {
          "$ref": "urn:ai-workflow:project-aggregate:v1:checkpoint"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              "active_area_conflict",
              "active_decision_required",
              "active_state_regression",
              "area_serialized",
              "branch_missing",
              "checkpoint_mismatch",
              "claim_conflict",
              "claim_stale",
              "claim_time",
              "collection_unknown",
              "constraint_fact",
              "constraint_pending",
              "constraint_unknown",
              "context_mismatch",
              "dependency_cycle",
              "dependency_incomplete",
              "dependency_waiting",
              "diagnostic_limit",
              "duplicate_area",
              "duplicate_dependency",
              "duplicate_fact",
              "duplicate_feature",
              "duplicate_issue",
              "feature_confirmation",
              "history_rewritten",
              "identity_mismatch",
              "impact_missing",
              "impact_unknown",
              "input_invalid",
              "input_limit",
              "invalid_issue_identity",
              "invalid_reason",
              "invalid_shared_area",
              "inventory_unknown",
              "issue_identity",
              "issue_missing",
              "issue_unknown",
              "load_invalid",
              "load_paths",
              "load_size",
              "missing_fact",
              "orphan_branch",
              "output_limit",
              "owner_mismatch",
              "pending_operation",
              "precondition",
              "previous_required",
              "release_unconfirmed",
              "revision_invalid",
              "schema_invalid",
              "self_dependency",
              "snapshot_stale",
              "source_unknown",
              "state_blocked",
              "state_unknown",
              "status_conflict",
              "status_mapping",
              "terminal_claim",
              "unknown_area",
              "unknown_dependency",
              "unknown_fact",
              "unpushed_unknown",
              "wave_unknown",
              "waves_missing",
              "workflow_duplicate",
              "workflow_identity",
              "workflow_invalid",
              "workflow_missing",
              "workflow_source",
              "workflow_unknown"
            ]
          },
          "kind": {
            "enum": [
              "invalid",
              "mismatch",
              "unknown",
              "warning"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "work_id": {
            "anyOf": [
              {
                "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
              },
              {
                "type": "null"
              }
            ]
          },
          "feature_id": {
            "anyOf": [
              {
                "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
              },
              {
                "type": "null"
              }
            ]
          },
          "recovery": {
            "enum": [
              "review_input",
              "reconcile",
              "confirm_facts",
              "claim_update"
            ]
          }
        },
        "required": [
          "code",
          "kind",
          "path",
          "work_id",
          "feature_id",
          "recovery"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "not_evaluated": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "maxItems": 100
    }
  },
  "required": [
    "schema_version",
    "aggregator_version",
    "input_digest",
    "project_id",
    "project_revision",
    "plan_revision",
    "project_digest",
    "plan_digest",
    "observed_at",
    "evaluated_at",
    "status",
    "checks",
    "issues",
    "features",
    "counts",
    "checkpoint",
    "diagnostics",
    "not_evaluated"
  ],
  "additionalProperties": false
}
