{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-workflow:dispatch:v1:ledger-view",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_kind": {
      "const": "ledger-view"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,128}$"
    },
    "configuration_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "status": {
      "enum": ["unmigrated", "ready", "recovery_required"]
    },
    "complete": {
      "const": true
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:dispatch:v1:common#/$defs/claim"
      },
      "maxItems": 10000
    },
    "pending_operations": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:dispatch:v1:common#/$defs/operation"
      },
      "maxItems": 100000
    },
    "history": {
      "type": "object",
      "properties": {
        "claims": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "operations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "events": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "required": ["claims", "operations", "events"],
      "additionalProperties": false
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,128}$"
          },
          "issues_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "issue_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "profile_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "stopped": {
            "type": "boolean"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "run_id",
          "issues_count",
          "issue_limit",
          "profile_digest",
          "stopped",
          "expires_at"
        ],
        "additionalProperties": false
      },
      "maxItems": 10000
    }
  },
  "required": [
    "schema_version",
    "artifact_kind",
    "project_id",
    "configuration_digest",
    "generation",
    "status",
    "complete",
    "claims",
    "pending_operations",
    "history",
    "runs"
  ],
  "additionalProperties": false
}
