{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-workflow:security:v1:report",
  "title": "security/v1 report",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_kind": {
      "const": "security-report"
    },
    "status": {
      "enum": [
        "pass",
        "blocked"
      ]
    },
    "decision": {
      "enum": [
        "evidence_complete",
        "needs_work",
        "human_review",
        "invalid"
      ]
    },
    "input_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_id": {
            "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
          },
          "status": {
            "$ref": "urn:ai-workflow:execution:v1:common#/$defs/outcome"
          },
          "finding_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "required": [
          "check_id",
          "status",
          "finding_count"
        ],
        "additionalProperties": false
      },
      "maxItems": 100,
      "minItems": 0
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:security:v1:common#/$defs/diagnostic"
      },
      "maxItems": 1000,
      "minItems": 0
    },
    "not_evaluated": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
      },
      "maxItems": 100,
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "decision",
    "input_digest",
    "checks",
    "diagnostics",
    "not_evaluated"
  ],
  "additionalProperties": false
}
