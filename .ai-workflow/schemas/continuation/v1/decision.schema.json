{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-workflow:continuation:v1:decision",
  "title": "continuation/v1 decision",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_kind": {
      "const": "continuation-decision"
    },
    "authority": {
      "const": false
    },
    "status": {
      "enum": ["passed", "blocked"]
    },
    "action": {
      "enum": ["start", "wait", "fence"]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "main_sha": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-f0-9]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "inventory_digest": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "selected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "feature_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
          },
          "human_owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "areas": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
            },
            "minItems": 0,
            "maxItems": 200
          },
          "allowed_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "minItems": 0,
            "maxItems": 1000
          },
          "forbidden_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "minItems": 0,
            "maxItems": 1000
          },
          "head_sha": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[a-f0-9]{40}$"
          },
          "profile_digest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "grant_digest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "contract_digest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "design_digest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
            },
            "minItems": 0,
            "maxItems": 100
          }
        },
        "required": [
          "issue_number",
          "feature_id",
          "human_owner",
          "areas",
          "allowed_paths",
          "forbidden_paths",
          "head_sha",
          "profile_digest",
          "grant_digest",
          "contract_digest",
          "design_digest",
          "stages"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 2
    },
    "held": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
            },
            "minItems": 0,
            "maxItems": 20
          }
        },
        "required": ["issue_number", "reasons"],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
      },
      "minItems": 0,
      "maxItems": 20
    }
  },
  "required": [
    "schema_version",
    "artifact_kind",
    "authority",
    "status",
    "action",
    "reason",
    "main_sha",
    "inventory_digest",
    "selected",
    "held",
    "diagnostics"
  ],
  "additionalProperties": false
}
