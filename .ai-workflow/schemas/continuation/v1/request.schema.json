{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-workflow:continuation:v1:request",
  "title": "continuation/v1 request",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_kind": {
      "const": "continuation-request"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "repository_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "owner_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "profile_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "nonce": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "intent": {
      "enum": ["continue", "status", "stop", "constrain"]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
        },
        "actor_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "actor_type": {
          "enum": ["User", "Bot"]
        },
        "body_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "actor_id", "actor_type", "body_digest", "updated_at"],
      "additionalProperties": false
    },
    "requested_issues": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "minItems": 1,
          "maxItems": 10
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "artifact_kind",
    "repository",
    "repository_id",
    "owner_id",
    "run_id",
    "profile_digest",
    "policy_digest",
    "event_id",
    "nonce",
    "intent",
    "issued_at",
    "expires_at",
    "source",
    "requested_issues"
  ],
  "additionalProperties": false
}
