{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-workflow:rules:v1:rule",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "rule_id": {
      "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "level": {
      "enum": [
        "always-on",
        "conditional",
        "opt-in"
      ]
    },
    "category": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "applies_when": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact": {
            "enum": [
              "risk",
              "areas",
              "technologies",
              "data_types"
            ]
          },
          "any_of": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "fact",
          "any_of"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "fact": {
                  "const": "risk"
                }
              }
            },
            "then": {
              "properties": {
                "any_of": {
                  "type": "array",
                  "items": {
                    "$ref": "urn:ai-workflow:issue:v1:common#/$defs/risk"
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        ]
      },
      "uniqueItems": true
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
          }
        },
        "required": [
          "rule_id",
          "version"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "conflicts_with": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
      },
      "uniqueItems": true
    },
    "after": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-workflow:issue:v1:common#/$defs/id"
      },
      "uniqueItems": true
    },
    "severity": {
      "enum": [
        "warn",
        "block"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "expected_outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "on_failure": {
      "type": "string",
      "minLength": 1
    },
    "approval_required": {
      "type": "boolean"
    },
    "body_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "file"
          },
          "target": {
            "$ref": "urn:ai-workflow:issue:v1:common#/$defs/filePath"
          }
        },
        "required": [
          "kind",
          "target"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true,
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "rule_id",
    "version",
    "level",
    "category",
    "applies_when",
    "requires",
    "conflicts_with",
    "after",
    "severity",
    "purpose",
    "inputs",
    "expected_outputs",
    "on_failure",
    "approval_required",
    "body_refs"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "level": {
            "const": "always-on"
          }
        }
      },
      "then": {
        "properties": {
          "applies_when": {
            "maxItems": 0,
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "level": {
            "const": "conditional"
          }
        }
      },
      "then": {
        "properties": {
          "applies_when": {
            "minItems": 1,
            "type": "array"
          }
        }
      }
    }
  ]
}
